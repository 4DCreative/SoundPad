<Window x:Class="SoundPad.PadSettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SoundPad.Services"
 Title="{local:Loc EditPad}" Width="520" Height="720" MinWidth="420" MinHeight="500"
 WindowStartupLocation="CenterOwner" Background="#17202C" Foreground="White" FontSize="17">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
  <TextBlock Text="{local:Loc EditPad}" FontSize="26" FontWeight="SemiBold"/>
  <TextBlock Text="{local:Loc Name}" Margin="0,20,0,6"/><TextBox x:Name="NameInput" Padding="10" MaxLength="60"/>
  <TextBlock Text="{local:Loc Color}" Margin="0,16,0,6"/>
  <ComboBox x:Name="ColorInput" Padding="10" SelectedValuePath="Tag">
   <ComboBoxItem Content="{local:Loc Blue}" Tag="#38BDF8"/><ComboBoxItem Content="{local:Loc Turquoise}" Tag="#2DD4BF"/>
   <ComboBoxItem Content="{local:Loc Orange}" Tag="#FB923C"/><ComboBoxItem Content="{local:Loc Violet}" Tag="#A78BFA"/>
   <ComboBoxItem Content="{local:Loc Pink}" Tag="#F472B6"/><ComboBoxItem Content="{local:Loc Yellow}" Tag="#FACC15"/>
  </ComboBox>
  <CheckBox x:Name="LoopInput" Content="{local:Loc RepeatLoop}" Foreground="White" Margin="0,20" Padding="6"/>
  <TextBlock Text="{local:Loc StartVolume}" FontWeight="SemiBold"/>
  <Slider x:Name="StartVolumeInput" Minimum="0" Maximum="1" Margin="0,12" MinHeight="36" IsMoveToPointEnabled="True" SmallChange=".01" LargeChange=".1" AutomationProperties.Name="Startlautstärke"/>
  <TextBlock Text="{Binding ElementName=StartVolumeInput,Path=Value,StringFormat={}{0:P0}}"/>
  <TextBlock Text="Setzt beim Start dieses Pads den linken Gesamtregler. Gilt auch für andere laufende Sounds. Änderungen greifen beim nächsten Start." TextWrapping="Wrap" FontSize="13" Foreground="#A8B8CC" Margin="0,8,0,20"/>
  <TextBlock Text="{local:Loc PadVolume}"/>
  <Slider x:Name="VolumeInput" Minimum="0" Maximum="1" Margin="0,14" IsMoveToPointEnabled="True" SmallChange=".05"/>
  <TextBlock Text="{Binding ElementName=VolumeInput,Path=Value,StringFormat={}{0:P0}}"/>
  <TextBlock x:Name="FileLabel" FontSize="12" Foreground="#A8B8CC" TextWrapping="Wrap" Margin="0,16"/>
  <WrapPanel>
   <Button Content="{local:Loc Save}" Click="Save" Padding="20,12" Margin="0,0,8,8" IsDefault="True"/>
   <Button Content="{local:Loc Cancel}" IsCancel="True" Padding="20,12" Margin="0,0,8,8"/>
   <Button Content="{local:Loc RemovePad}" Click="Remove" Padding="20,12" Margin="0,0,8,8"/>
  </WrapPanel>
 </StackPanel></ScrollViewer>
</Window>


