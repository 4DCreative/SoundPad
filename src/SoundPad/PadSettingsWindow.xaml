<Window x:Class="SoundPad.PadSettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Pad bearbeiten" Width="520" Height="720" MinWidth="420" MinHeight="500"
 WindowStartupLocation="CenterOwner" Background="#17202C" Foreground="White" FontSize="17">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
  <TextBlock Text="Pad bearbeiten" FontSize="26" FontWeight="SemiBold"/>
  <TextBlock Text="Name" Margin="0,20,0,6"/><TextBox x:Name="NameInput" Padding="10" MaxLength="60"/>
  <TextBlock Text="Farbe" Margin="0,16,0,6"/>
  <ComboBox x:Name="ColorInput" Padding="10" SelectedValuePath="Tag">
   <ComboBoxItem Content="Blau" Tag="#38BDF8"/><ComboBoxItem Content="Türkis" Tag="#2DD4BF"/>
   <ComboBoxItem Content="Orange" Tag="#FB923C"/><ComboBoxItem Content="Violett" Tag="#A78BFA"/>
   <ComboBoxItem Content="Rosa" Tag="#F472B6"/><ComboBoxItem Content="Gelb" Tag="#FACC15"/>
  </ComboBox>
  <CheckBox x:Name="LoopInput" Content="↻  Sound in Schleife wiederholen" Foreground="White" Margin="0,20" Padding="6"/>
  <TextBlock Text="Startlautstärke (Gesamtlautstärke)" FontWeight="SemiBold"/>
  <Slider x:Name="StartVolumeInput" Minimum="0" Maximum="1" Margin="0,12" MinHeight="36" IsMoveToPointEnabled="True" SmallChange=".01" LargeChange=".1" AutomationProperties.Name="Startlautstärke"/>
  <TextBlock Text="{Binding ElementName=StartVolumeInput,Path=Value,StringFormat={}{0:P0}}"/>
  <TextBlock Text="Setzt beim Start dieses Pads den linken Gesamtregler. Gilt auch für andere laufende Sounds. Änderungen greifen beim nächsten Start." TextWrapping="Wrap" FontSize="13" Foreground="#A8B8CC" Margin="0,8,0,20"/>
  <TextBlock Text="Pad-Lautstärke (relative Lautstärke)"/>
  <Slider x:Name="VolumeInput" Minimum="0" Maximum="1" Margin="0,14" IsMoveToPointEnabled="True" SmallChange=".05"/>
  <TextBlock Text="{Binding ElementName=VolumeInput,Path=Value,StringFormat={}{0:P0}}"/>
  <TextBlock x:Name="FileLabel" FontSize="12" Foreground="#A8B8CC" TextWrapping="Wrap" Margin="0,16"/>
  <WrapPanel>
   <Button Content="Speichern" Click="Save" Padding="20,12" Margin="0,0,8,8" IsDefault="True"/>
   <Button Content="Abbrechen" IsCancel="True" Padding="20,12" Margin="0,0,8,8"/>
   <Button Content="Pad entfernen" Click="Remove" Padding="20,12" Margin="0,0,8,8"/>
  </WrapPanel>
 </StackPanel></ScrollViewer>
</Window>

